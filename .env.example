# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Panel admina
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# SMTP (oferty z chatbota — lokalnie; na Render Free nie działa)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT_SSL=465
SMTP_PORT_TLS=587
SMTP_LOGIN=info@example.com
SMTP_PASSWORD=your-app-password

# Resend (produkcja na Render — HTTPS, działa na darmowym planie)
RESEND_API_KEY=re_your-key-here
RESEND_FROM=Dragon AI <onboarding@resend.dev>
OFFER_RECIPIENTS=info@gamm-bud.com

# Serwer
HOST=127.0.0.1
PORT=8000
